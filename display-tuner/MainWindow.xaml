<ui:FluentWindow x:Class="DisplayTuner.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="显示器参数调节"
                 Icon="/app.ico"
                 Width="580" Height="460"
                 MinWidth="520" MinHeight="400"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="显示器参数调节" />

        <!-- 显示器选择 -->
        <Grid Grid.Row="1" Margin="16,4,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="显示器" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" x:Name="DisplayCombo"
                      VerticalAlignment="Center"
                      SelectionChanged="DisplayCombo_Changed"/>
            <ui:Button Grid.Column="2" x:Name="RefreshButton" Content="刷新"
                       Margin="10,0,0,0" Click="Refresh_Click"/>
        </Grid>

        <!-- 分辨率 / 刷新率 -->
        <Grid Grid.Row="2" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Padding="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="分辨率" FontWeight="SemiBold" Margin="4,0,0,8"/>
                    <ListBox x:Name="ResolutionList"
                             DisplayMemberPath="Label"
                             SelectionChanged="ResolutionList_Changed"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="8" Padding="10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="刷新率" FontWeight="SemiBold" Margin="4,0,0,8"/>
                    <ListBox x:Name="FrequencyList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}{0} Hz}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 当前模式 + 应用 -->
        <Grid Grid.Row="3" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentModeText" Text="当前模式：—" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="" Margin="0,4,0,0"
                           TextWrapping="Wrap" Opacity="0.85"/>
            </StackPanel>
            <ui:Button Grid.Column="1" x:Name="ApplyButton" Content="应用"
                       Appearance="Primary" Width="120" Height="40"
                       Click="Apply_Click"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
