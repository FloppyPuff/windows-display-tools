<ui:FluentWindow x:Class="DisplayTuner.ConfirmWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="切换确认"
                 Icon="/app.ico"
                 Width="440" Height="292"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="切换确认" />

        <Grid Grid.Row="1" Margin="22,4,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="DescText" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="OldText" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="CountdownText"
                       FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="KeepButton" Content="保持此设置" Appearance="Primary"
                           Width="124" Height="38" Click="Keep_Click"/>
                <ui:Button x:Name="RevertButton" Content="恢复原设置"
                           Width="124" Height="38" Margin="10,0,0,0"
                           IsDefault="True" IsCancel="True" Click="Revert_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
